<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Light -->
    <Color x:Key="BackgroundLight">#F5F6F8</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedLight">#EEF0F3</Color>
    <Color x:Key="BorderLight">#E2E5EA</Color>
    <Color x:Key="TextLight">#15181D</Color>
    <Color x:Key="TextMutedLight">#5D6470</Color>
    <Color x:Key="AccentLight">#2A62D9</Color>
    <Color x:Key="AccentSoftLight">#E6EDFB</Color>
    <Color x:Key="SuccessLight">#1D7F52</Color>
    <Color x:Key="WarningLight">#A86A12</Color>
    <Color x:Key="DangerLight">#C23A34</Color>

    <!-- Dark -->
    <Color x:Key="BackgroundDark">#0F1114</Color>
    <Color x:Key="SurfaceDark">#181B20</Color>
    <Color x:Key="SurfaceMutedDark">#22262D</Color>
    <Color x:Key="BorderDark">#2A2F37</Color>
    <Color x:Key="TextDark">#E7E9EC</Color>
    <Color x:Key="TextMutedDark">#99A0AB</Color>
    <Color x:Key="AccentDark">#7AA5FF</Color>
    <Color x:Key="AccentSoftDark">#1E2A42</Color>
    <Color x:Key="SuccessDark">#4CC38A</Color>
    <Color x:Key="WarningDark">#E0A84A</Color>
    <Color x:Key="DangerDark">#F07A73</Color>

    <Color x:Key="OnAccent">#FFFFFF</Color>
</ResourceDictionary>
