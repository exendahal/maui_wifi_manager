<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DemoApp.NetworkInfo"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Connection">
    <RefreshView x:Name="refreshView" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,32">
                <Label Style="{StaticResource PageTitle}" Text="Connection" />

                <Border
                    Margin="0,16,0,0"
                    Padding="16"
                    Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                x:Name="ssidTxt"
                                FontFamily="OpenSansSemibold"
                                FontSize="22"
                                LineBreakMode="TailTruncation"
                                Text="Loading…" />
                            <Label x:Name="summaryTxt" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Border
                            x:Name="statusPill"
                            Grid.Column="1"
                            Padding="10,4"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                            <Label
                                x:Name="statusPillTxt"
                                FontFamily="OpenSansSemibold"
                                FontSize="12" />
                        </Border>
                    </Grid>
                </Border>

                <Label Style="{StaticResource SectionHeader}" Text="Connectivity" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource FieldRow}">
                            <Label Style="{StaticResource FieldLabel}" Text="Internet access" />
                            <Label
                                x:Name="internetTxt"
                                Grid.Column="1"
                                Style="{StaticResource FieldValue}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource FieldRow}">
                            <Label Style="{StaticResource FieldLabel}" Text="Captive portal" />
                            <Label
                                x:Name="captiveTxt"
                                Grid.Column="1"
                                Style="{StaticResource FieldValue}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Button
                            x:Name="checkBtn"
                            Margin="0,4"
                            Padding="0"
                            Clicked="CheckClicked"
                            HorizontalOptions="Start"
                            Style="{StaticResource TextButton}"
                            Text="Check again" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionHeader}" Text="Details" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout x:Name="detailsList" />
                </Border>

                <Label Style="{StaticResource SectionHeader}" Text="Activity" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label
                            x:Name="activityEmptyTxt"
                            Padding="0,14"
                            Style="{StaticResource Muted}"
                            Text="Listening for Wi-Fi changes. Switch networks or turn Wi-Fi off to see events here." />
                        <VerticalStackLayout x:Name="activityList" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource SectionHeader}" Text="System settings" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Style="{StaticResource FieldRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="WifiSettingsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="Wi-Fi settings" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Muted}"
                                Text="›"
                                FontSize="20"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="*,Auto" Style="{StaticResource FieldRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NetworkSettingsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="Network &amp; internet settings" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Muted}"
                                Text="›"
                                FontSize="20"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="disconnectSection" Margin="0,24,0,0" Spacing="8">
                    <Button
                        x:Name="disconnectBtn"
                        Clicked="DisconnectClicked"
                        Style="{StaticResource DangerButton}"
                        Text="Disconnect" />
                    <Label
                        x:Name="disconnectHintTxt"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Muted}" />
                </VerticalStackLayout>

                <Button
                    x:Name="nativeToggleBtn"
                    Margin="0,16,0,0"
                    Clicked="NativeToggleClicked"
                    HorizontalOptions="Center"
                    Style="{StaticResource TextButton}"
                    Text="Show platform object" />
                <Border
                    x:Name="nativeCard"
                    IsVisible="False"
                    Padding="16,12"
                    Style="{StaticResource Card}">
                    <Label
                        x:Name="nativeTxt"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="12" />
                </Border>

                <Label
                    x:Name="versionTxt"
                    Margin="0,24,0,0"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Muted}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
