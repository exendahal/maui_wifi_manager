<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DemoApp.ConnectWifi"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Shell.TitleView>
        <Grid>
            <Label
                Grid.Column="1"
                FontSize="Title"
                HorizontalTextAlignment="Start"
                Text="MAUI Wi-Fi Manager"
                TextColor="{StaticResource SecondaryDarkText}"
                TextTransform="Uppercase"
                VerticalTextAlignment="Center" />
        </Grid>
    </Shell.TitleView>
    <ScrollView>
        <StackLayout>
            <Image HeightRequest="160" Source="dotnet_bot.png" />
            <Label
                FontSize="Title"
                HorizontalOptions="Center"
                Text="Connect Wi-Fi"
                TextColor="{StaticResource SecondaryDarkText}"
                TextTransform="Uppercase" />
            <StackLayout Padding="40,20">
                <Label
                    Margin="0,12,0,4"
                    FontSize="12"
                    Text="Enter Wi-Fi SSID"
                    TextColor="{StaticResource SecondaryDarkText}"
                    TextTransform="Uppercase" />
                <Entry
                    x:Name="WifiSsid"
                    Placeholder="Wi-Fi SSID"
                    Text="Minions_5" />

                <Label
                    Margin="0,12,0,4"
                    FontSize="12"
                    Text="Enter Wi-Fi Password"
                    TextColor="{StaticResource SecondaryDarkText}"
                    TextTransform="Uppercase" />
                <Entry
                    x:Name="WifiPassword"
                    Placeholder="Wi-Fi Password"
                    Text="CLB2727979" />

                <Label
                    Margin="0,12,0,4"
                    FontSize="12"
                    Text="Security Type"
                    TextColor="{StaticResource SecondaryDarkText}"
                    TextTransform="Uppercase" />
                <Picker x:Name="SecurityTypePicker" Title="Select security type">
                    <Picker.Items>
                        <x:String>WPA2-PSK</x:String>
                        <x:String>WPA3-SAE</x:String>
                        <x:String>WPA-PSK</x:String>
                        <x:String>Open (No Password)</x:String>
                        <x:String>WEP</x:String>
                    </Picker.Items>
                </Picker>

                <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label
                        Grid.Column="0"
                        FontSize="12"
                        Text="Hidden Network (SSID not broadcast)"
                        TextColor="{StaticResource SecondaryDarkText}"
                        TextTransform="Uppercase"
                        VerticalOptions="Center" />
                    <Switch
                        x:Name="IsHiddenSwitch"
                        Grid.Column="1"
                        IsToggled="False"
                        VerticalOptions="Center" />
                </Grid>

                <Button
                    x:Name="ConnectBtn"
                    Grid.Column="0"
                    Margin="0,32"
                    BackgroundColor="{StaticResource SecondaryDarkText}"
                    Clicked="ConnectBtnClicked"
                    FontSize="12"
                    Text="Connect Wi-Fi"
                    TextColor="White"
                    TextTransform="Uppercase" />
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
