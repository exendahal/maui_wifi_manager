<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DemoApp.ScanListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DemoApp"
    Title="Networks">
    <Grid Padding="20,16,20,0" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Style="{StaticResource PageTitle}" Text="Networks" />
                <HorizontalStackLayout Spacing="8">
                    <ActivityIndicator
                        x:Name="scanningIndicator"
                        HeightRequest="14"
                        VerticalOptions="Center"
                        WidthRequest="14" />
                    <Label
                        x:Name="statusTxt"
                        Style="{StaticResource Muted}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button
                x:Name="scanBtn"
                Grid.Column="1"
                Clicked="ScanClicked"
                Style="{StaticResource TextButton}"
                VerticalOptions="Start" />
        </Grid>

        <Border
            x:Name="throttleNotice"
            Grid.Row="1"
            Margin="0,16,0,0"
            Style="{StaticResource Notice}">
            <Label Style="{StaticResource Muted}" Text="Android allows 4 scans every 2 minutes, so this list refreshes about every 30 seconds. Pull down to scan now." />
        </Border>

        <RefreshView
            x:Name="refreshView"
            Grid.Row="2"
            Margin="0,12,0,0"
            Refreshing="OnRefreshing">
            <CollectionView x:Name="networkList" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="24,64"
                        HorizontalOptions="Center"
                        Spacing="6">
                        <Label
                            x:Name="emptyTitle"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource RowTitle}"
                            Text="Looking for networks" />
                        <Label
                            x:Name="emptyMessage"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource Muted}"
                            Text="Networks in range appear here as they are found." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:NetworkDataModel">
                        <Border Padding="16,12" Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="NetworkTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <HorizontalStackLayout
                                    HeightRequest="18"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <BoxView
                                        CornerRadius="1"
                                        HeightRequest="6"
                                        Opacity="{Binding Bar1}"
                                        VerticalOptions="End"
                                        WidthRequest="4"
                                        Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    <BoxView
                                        CornerRadius="1"
                                        HeightRequest="10"
                                        Opacity="{Binding Bar2}"
                                        VerticalOptions="End"
                                        WidthRequest="4"
                                        Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    <BoxView
                                        CornerRadius="1"
                                        HeightRequest="14"
                                        Opacity="{Binding Bar3}"
                                        VerticalOptions="End"
                                        WidthRequest="4"
                                        Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    <BoxView
                                        CornerRadius="1"
                                        HeightRequest="18"
                                        Opacity="{Binding Bar4}"
                                        VerticalOptions="End"
                                        WidthRequest="4"
                                        Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label Style="{StaticResource RowTitle}" Text="{Binding DisplayName}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsHidden}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="FontAttributes" Value="Italic" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Style="{StaticResource Muted}" Text="{Binding Summary}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding SignalText}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
